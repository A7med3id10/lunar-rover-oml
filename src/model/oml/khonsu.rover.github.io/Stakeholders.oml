@dc:title "Khonsu Stakeholders"
description <https://khonsu.rover.github.io/Stakeholders#> as Stakeholders {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <https://www.modelware.io/khonsu/base#> as base
    uses <https://www.modelware.io/khonsu/vocabulary#> as vocab
    extends <https://khonsu.rover.github.io/instances#> as instances

    instance MissionOperationsTeam : vocab:Stakeholder [
        base:description "Team that plans traverses and commands the rover."
        vocab:teamSizePeople 6
        vocab:IsResponsibleFor Resp2
        vocab:hasInterestIn instances:SouthPoleTraverse
        base:category "Operations"
    ]

    instance ScienceTeam : vocab:Stakeholder [
        base:description "Team that defines payload and science objectives."
        vocab:teamSizePeople 5
        vocab:hasInterestIn instances:SouthPoleTraverse
        base:category "Science"
    ]

    instance Resp1 : vocab:Responsibility [
        base:description "Define payload and science objectives."
        vocab:IsAssignedTo ScienceTeam
    ]

    instance Resp2 : vocab:Responsibility [
        base:description "Plan traverses and command the rover."
    ]

    instance ProjectManager : vocab:Stakeholder [
        base:description "manages the teams"
        vocab:hasInterestIn instances:Mission1
        vocab:teamSizePeople 1
    ]

    instance SubsystemTechnicalLeads : vocab:Stakeholder [
        base:description "Team Leaders of Design Teams of subsystems"
        vocab:hasInterestIn instances:Mission1
        vocab:teamSizePeople 7
    ]
}
