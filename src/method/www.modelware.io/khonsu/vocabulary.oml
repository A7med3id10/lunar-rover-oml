@dc:title "Khonsu Vocabulary"
vocabulary <https://www.modelware.io/khonsu/vocabulary#> as khonsu {
    extends <http://purl.org/dc/elements/1.1/> as dc
    extends <http://www.w3.org/2001/XMLSchema#> as xsd
    extends <https://www.modelware.io/khonsu/base#> as base
    extends <http://opencaesar.io/isq/> as isq
     

    // Part A - Initial vocabulary  
    

    // Task 1: concepts
    @dc:description "A Mission is a high-level objective."
    concept Mission < base:Element
[
    restricts   isExecutedBy to min 1 Rover
    restricts   isOfInterestTo to min 1 Stakeholder
]

    @dc:description "A verifiable statement of a mission or system need."
    concept Requirement < base:Expressible, base:Element
    
    @dc:description "A Hazard is a threat to the mission."
    concept Hazard < base:Element

    @dc:description "A Terrain is a lunar surface feature."
    concept Terrain < base:Element

    @dc:description "A Rover is an autonomous system to explore the lunar surface."
    concept Rover < base:Container, base:Element
[
    restricts   executes to min 1 Mission
    restricts   provides to min 1 MobilityCapability
    restricts   provides to min 1 NavigationCapability
]

    @dc:description "A State is a description of the rover's condition."
    concept State < base:Element

    @dc:description "A Satellite is a space-based system."
    concept Satellite < base:Element ,  base:Container  

    @dc:description "A GroundStation is a terrestrial system for communicating with space assets."
    concept GroundStation < base:Element
     
    @dc:description "A component is a part of a system."
    concept Component < base:Container, base:Contained, base:Element
    [
        restricts all base:isContainedBy to  Component
    ]

    @dc:description "A Stakeholder is an entity that has interests in Requirements (people, organizations)."
    concept Stakeholder < base:Categorized, base:Element
    
    @dc:description "A Capability is a feature that a system can perform."
    concept Capability < base:Element
    
    @dc:description "A Verification Activity is a planned or executed activity to verify a requirement."
    concept VerificationActivity < base:Element



    // Task 2: Taxonomy / specialization

    @dc:description "A SubSystem is a component of a larger system."
    concept SubSystem < Component  
       
    @dc:description "An Actuator is a component that applies forces or controls physical properties."
    concept Actuator < Component

    @dc:description "A Sensor is a component that detects or measures physical properties."
    concept Sensor < Component

    @dc:description "A WheeledRover is a type of rover with wheels."
    concept WheeledRover < Rover

    @dc:description "A TrackedRover is a type of rover with tracks."
    concept TrackedRover < Rover

    @dc:description "A CameraSensor is a type of sensor that captures images."
    concept CameraSensor < Sensor

    @dc:description "An FPGA is a type of component for high-speed processing."
    concept FPGA < Component

    @dc:description "A LiDAR sensor is a type of sensor that uses laser light to measure distances."
    concept LiDARSensor < Sensor

    @dc:description "A Navigation capability is a feature that enables a system to determine its position and orientation."
    concept NavigationCapability < Capability

    @dc:description "A Mobility capability is a feature that enables a system to move from one location to another."
    concept MobilityCapability < Capability
[
    restricts   isDrivenBy to min 1 Actuator
    //restricts   isProvidedBy to min 1 Rover
]

    @dc:description "A rover aggregates its subsystems and other directly managed components."
    relation entity Aggregates [
        from Rover
        to Component
        forward aggregates
        reverse isAggregatedBy
    ] < base:Contains

    @dc:description "A component is composed of nested components; this relation can be applied recursively."
    relation entity Composes [
        from Component
        to Component
        forward composes
        reverse isComposedIn
    ] < base:Contains

    @dc:description "A mission is decomposed into subordinate missions."
    relation entity MissionDecomposition [
        from Mission
        to Mission
        forward decomposes
        reverse isDecomposedFrom
    ] < base:Element

    @dc:description "A mission pursues one or more requirements."
    relation entity Pursuit [
        from Mission
        to Requirement
        forward pursues
        reverse isPursuedBy
    ] < base:Element

    @dc:description "A capability satisfies a requirement."
    relation entity Satisfaction [
        from Capability
        to Requirement
        forward satisfies
        reverse isSatisfiedBy
    ] < base:Element

    @dc:description "A subsystem implements a capability."
    relation entity CapabilityImplementation [
        from Capability
        to SubSystem
        forward implementedBy
        reverse implements
    ] < base:Element

    // Task 3: Scalar properties


    @dc:description "A LinkBudget is a constraint on the communication link between a rover and a ground station."
    scalar property LinkBudget [
        domain Rover
        range xsd:double
        functional
    ]
 
   @dc:description "A DataRate is the amount of data that can be transmitted over the communication link between a rover and a ground station."
    scalar property DataRate [
        domain Rover
        range xsd:double
        functional
    ]
    
   @dc:description "A batteryLevel is a measure of the remaining charge in a rover's battery."
    scalar property batteryLevel [
        domain Rover
        range xsd:double
        functional
    ]

    @dc:description "A speed is a measure of the speed of a rover."
    scalar property speed [
        domain Rover
        range xsd:double
        functional
    ]
   

  @dc:description "A Risk Level level assigned to an element."
    scalar RiskLevel [
        oneOf "Low", "Medium", "High"
    ] = xsd:string

   @dc:description "A Risk Level is a measure of the risk associated with a hazard."
    scalar property riskLevel [
        domain Hazard
        range RiskLevel
        functional
    ]

    @dc:description "The mass of the Component."
    quantity property mass [
        domain base:Container
        quantity isq:Mass
        functional
    ]

    @dc:description "Power consumption in for powered assets."
    quantity property powerConsumption [
        domain base:Element
        quantity isq:Power 
        functional
    ]
 
    @dc:description "Power generated in watts by a physical system."
    quantity property powerGeneration [
        domain base:Element
        quantity isq:Power 
        functional
    ]

    @dc:description "Lifecycle or model maturity status (for example, Conceptual, Preliminary, or Operational)."
    scalar property maturityLevel [
        domain base:Element
        range xsd:string
        functional
    ]

    @dc:description "Autonomy level or TBD/N/A when not established or not applicable."
    scalar property autonomyLevel [
        domain base:Element
        range xsd:string
        functional
    ]

    @dc:description "Likelihood of a hazard occurring; use TBD until assessed."
    scalar property occurrenceLikelihood [
        domain Hazard
        range xsd:string
        functional
    ]

    @dc:description "Severity of a hazard's consequences; use TBD until assessed."
    scalar property consequenceSeverity [
        domain Hazard
        range xsd:string
        functional
    ]

    @dc:description "Status of planned or implemented responses to a hazard; use TBD until defined."
    scalar property mitigationStatus [
        domain Hazard
        range xsd:string
        functional
    ]

    @dc:description "Terrain slope classification relevant to rover traversability; use TBD until characterized."
    scalar property terrainSlopeClass [
        domain Terrain
        range xsd:string
        functional
    ]

    @dc:description "Terrain feature class relevant to rover route planning."
    scalar property terrainClass [
        domain Terrain
        range xsd:string
        functional
    ]

    @dc:description "Assessment of rover traversability; use TBD until evaluated."
    scalar property traversability [
        domain Terrain
        range xsd:string
        functional
    ]

    

    @dc:description "Planned or measured mission duration in hours; use TBD when not established."
    scalar property missionDurationHours [
        domain Mission
        range xsd:string
        functional
    ]

    @dc:description "Primary objective of a mission."
    scalar property missionObjective [
        domain Mission
        range xsd:string
        functional
    ]

    @dc:description "Lifecycle status of a requirement, such as Draft, Proposed, or Approved."
    scalar property requirementStatus [
        domain Requirement
        range xsd:string
        functional
    ]


    @dc:description "Status of verification approach for a requirement."
    scalar property verificationStatus [ 
        domain VerificationActivity 
        range VerificationStatus 
        functional
        ]

   scalar VerificationStatus [
     oneOf "Planned", "InProgress", "Completed", "Failed" 
     ]

    @dc:description "Expected lunar-night hibernation duration in hours; use TBD when not established."
    scalar property hibernationDurationHours [
        domain Mission
        range xsd:string
        functional
    ]

    @dc:description "Planned traverse distance in kilometers; use TBD when not established."
    scalar property traverseDistanceKm [
        domain Mission
        range xsd:string
        functional
    ]

    @dc:description "Ground-station antenna diameter in meters."
    scalar property antennaDiameterM [
        domain GroundStation
        range xsd:string
        functional
    ]

    @dc:description "Number of people assigned to a stakeholder team; use TBD until staffing is defined."
    scalar property teamSizePeople [
        domain Stakeholder
        range xsd:string
        functional
    ]

    @dc:description "Primary operational responsibility of a stakeholder team."
    scalar property teamResponsibility [
        domain Stakeholder
        range xsd:string
        functional
    ]

    @dc:description "Maximum slope traversable by a mobility capability in degrees; use TBD until verified."
    scalar property traversalSlopeLimitDeg [
        domain MobilityCapability
        range xsd:string
        functional
    ]

    @dc:description "Maximum obstacle height a mobility capability can traverse in centimeters; use TBD until verified."
    scalar property obstacleHeightLimitCm [
        domain MobilityCapability
        range xsd:string
        functional
    ]

    @dc:description "Terrain types a mobility capability is designed to traverse."
    scalar property supportedTerrain [
        domain MobilityCapability
        range xsd:string
        functional
    ]

    @dc:description "Expected localization accuracy for a navigation capability; use TBD until specified."
    scalar property localizationAccuracyM [
        domain NavigationCapability
        range xsd:string
        functional
    ]

    @dc:description "Useful perception or hazard-detection range for a navigation capability; use TBD until specified."
    scalar property perceptionRangeM [
        domain NavigationCapability
        range xsd:string
        functional
    ]

    @dc:description "Path-planning behavior of a navigation capability."
    scalar property pathPlanningMode [
        domain NavigationCapability
        range xsd:string
        functional
    ]

    @dc:description "Variable monitored by a condition."
    scalar property triggerVariable [
        domain base:Condition
        range xsd:string
        functional
    ]

    @dc:description "Threshold that causes a condition to become true; use TBD until specified."
    scalar property triggerThreshold [
        domain base:Condition
        range xsd:string
        functional
    ]

    @dc:description "Primary activity performed in an operational state."
    scalar property operatingActivity [
        domain State
        range xsd:string
        functional
    ]

    @dc:description "Qualitative power profile for a state; include a quantified value only when established."
    scalar property statePowerProfile [
        domain State
        range xsd:string
        functional
    ]

    @dc:description "Control and autonomy behavior while the state is active."
    scalar property stateControlMode [
        domain State
        range xsd:string
        functional
    ]

    @dc:description "Expected duration of an operational state; use TBD when not established."
    scalar property stateDurationHours [
        domain State
        range xsd:string
        functional
    ]
 

  // Task 4: relations from/to/reverse
  @dc:description "A rover executes a mission."
  relation entity Executes [
      from Rover
      to Mission
      forward executes
      reverse isExecutedBy
  ] < base:Element
  
  @dc:description "A sensor enables a navigation capability."
  relation entity Enables [
      from Sensor
      to NavigationCapability
      forward enables
      reverse isEnabledBy
  ] < base:Element
  
  @dc:description "An actuator drives a mobility capability."
  relation entity Drives [
      from Actuator
      to MobilityCapability
      forward drives
      reverse isDrivenBy
  ] < base:Element
  
  @dc:description "A hazard threatens a mission."
  relation entity Threatens [
      from Hazard
      to Mission
      forward threatens
      reverse isThreatenedBy
  ] < base:Element
  
  @dc:description "A hazard degrades a capability."
  relation entity Degrades [
      from Hazard
      to Capability
      forward degrades
      reverse isDegradedBy
  ] < base:Element

  @dc:description "A rover provides a capability."
  relation entity Provides [
      from Rover
      to Capability
      forward provides
      reverse isProvidedBy
  ] < base:Element

  @dc:description "A rover traverses terrain."
  relation entity Traverses [
      from Rover
      to Terrain
      forward traverses
      reverse isTraversedBy
  ] < base:Element

  @dc:description "A stakeholder has an interest in a mission."
  relation entity HasInterestIn [
      from Stakeholder
      to Mission
      forward hasInterestIn
      reverse isOfInterestTo
  ] < base:Element
  
  @dc:description "A state is entered when a condition holds."
  relation entity IsEnteredWhen [
      from State
      to base:Condition
      forward isEnteredWhen
      reverse triggersEntryTo
  ] < base:Element
  

  @dc:description "A state is entered when a condition holds."
  relation entity IsVerifiedBy [
    from Requirement
    to VerificationActivity
    forward isVerifiedBy
    reverse verifies
  ] < base:Element 
    
}
